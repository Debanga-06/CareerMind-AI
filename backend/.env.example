# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins (local React dev, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- SerpApi (required) ---
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_TIMEOUT_SECONDS=20
SERPAPI_MAX_RETRIES=2
SERPAPI_CACHE_TTL_SECONDS=1800

# --- Rate limiting (simple in-process limiter) ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
# SQLite is used out of the box for local dev. Swap in a real Postgres /
# Supabase connection string for production, e.g.:
# postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./careergraph_dev.db

# --- JWT Auth (used from Stage 5 onward) ---
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI provider abstraction (used from Stage 4 onward) ---
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
